<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F3F6FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EVENT &amp; VALIDATION"
            android:textSize="13sp"
            android:textColor="#2563EB"
            android:textStyle="bold"
            android:letterSpacing="0.10" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Đăng ký sinh viên"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#17253E" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Vui lòng nhập đầy đủ thông tin bên dưới để hoàn tất đăng ký."
            android:textSize="14sp"
            android:textColor="#64748B" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_input"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- HỌ VÀ TÊN -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Họ và tên *"
                android:textColor="#334155"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtHoTen"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Ví dụ: Nguyễn Văn An"
                android:inputType="textPersonName|textCapWords"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:padding="12dp"
                android:textColor="#17253E"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

            <!-- EMAIL -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Email *"
                android:textColor="#334155"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Ví dụ: student@gmail.com"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:padding="12dp"
                android:textColor="#17253E"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

            <!-- SỐ ĐIỆN THOẠI -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Số điện thoại *"
                android:textColor="#334155"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtSdt"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Ví dụ: 0912345678"
                android:inputType="phone"
                android:maxLength="13"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:padding="12dp"
                android:textColor="#17253E"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

            <!-- MÃ SINH VIÊN -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Mã sinh viên *"
                android:textColor="#334155"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtMsv"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Nhập mã số sinh viên"
                android:inputType="number"
                android:maxLength="15"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:padding="12dp"
                android:textColor="#17253E"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

            <!-- LỚP -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Lớp *"
                android:textColor="#334155"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtLop"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Ví dụ: 23T1"
                android:inputType="text"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:padding="12dp"
                android:textColor="#17253E"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

            <!-- BUTTON ĐĂNG KÝ -->

            <Button
                android:id="@+id/btnDangKi"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="26dp"
                android:backgroundTint="#2563EB"
                android:text="ĐĂNG KÝ"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="* Vui lòng điền các trường bắt buộc"
            android:textColor="#64748B"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
